modules = ["nodejs-20", "web", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "mesa", "pango", "cairo", "alsa-lib", "libxkbcommon"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5001
externalPort = 3002

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Blog API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend Server"

[[workflows.workflow]]
name = "GitHub Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Ready to sync to GitHub! Run 'npm run sync' to push your changes.\""

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Blog API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd part4 && NODE_ENV=test node index.js"
waitForPort = 3003

[[workflows.workflow]]
name = "Frontend Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd part5 && npm run dev"
waitForPort = 5000
